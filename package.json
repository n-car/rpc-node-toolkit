{
  "name": "rpc-node-toolkit",
  "version": "0.2.1",
  "description": "Framework-agnostic Node.js JSON-RPC 2.0 toolkit with HTTP handler support, schema validation, and RPC Toolkit Safe Mode.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    },
    "./safe": {
      "types": "./src/safe.d.ts",
      "require": "./src/safe.js",
      "import": "./src/safe.js"
    }
  },
  "files": [
    "src/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/core.test.js",
    "example:http": "node examples/http-server.js",
    "example:batch": "node examples/batch-and-notification.js",
    "example:schema": "node examples/schema-validation.js",
    "example:safe": "node examples/safe-mode-roundtrip.js",
    "typecheck": "node test/package/runner.js --types-only",
    "package-test": "node test/package/runner.js",
    "prepack": "npm test",
    "prepublishOnly": "npm run package-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-car/rpc-node-toolkit.git"
  },
  "keywords": [
    "json-rpc",
    "jsonrpc",
    "json-rpc-2.0",
    "rpc",
    "node",
    "nodejs",
    "http",
    "server",
    "client",
    "batch",
    "safe-mode",
    "rpc-toolkit"
  ],
  "author": {
    "name": "Nicola Carpanese",
    "url": "https://github.com/n-car"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/n-car/rpc-node-toolkit/issues"
  },
  "homepage": "https://github.com/n-car/rpc-node-toolkit#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^18.19.0",
    "publint": "^0.3.22",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "rpc-toolkit-js-client": "^1.1.3"
  }
}
